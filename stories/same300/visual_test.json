  "long": "Hypothetical 7% nominal annual return. Compounded monthly, deposits at the end of each month. Not guaranteed. Not financial advice. No fees, taxes or inflation included."
 },
 "lines": [
  {
   "id": "a1",
   "speaker": "broke",
   "text": "Three hundred bucks a month. Finally, I can upgrade everything!"
  },
  {
   "id": "a2",
   "speaker": "lobe",
   "text": "Or you could let that money grow."
  },
  {
   "id": "a3",
   "speaker": "broke",
   "text": "Grow? Money doesn't grow on trees."
  },
  {
   "id": "a4",
   "speaker": "lobe",
   "text": "No. It grows on time."
  },
  {
   "id": "b1",
   "speaker": "narrator",
   "text": "Every month, the same three hundred dollars."
  },
  {
   "id": "b2",
   "speaker": "narrator",
   "text": "Left spends it the day it arrives."
  },
  {
   "id": "b3",
   "speaker": "narrator",
   "text": "Right invests it, and leaves it alone."
  },
  {
   "id": "b4",
   "speaker": "narrator",
   "text": "After one year, Right's pile is already a little bigger."
  },
  {
   "id": "c1",
   "speaker": "narrator",
   "text": "Now let five years go by."
  },
  {
   "id": "c2",
   "speaker": "narrator",
   "text": "Left keeps spending. The stuff piles up, then wears out."
  },
  {
   "id": "c3",
   "speaker": "narrator",
   "text": "Right keeps investing, and the money starts growing by itself."
  },
  {
   "id": "c4",
   "speaker": "narrator",
   "text": "Five years later: eighteen thousand dollars spent."
  },
  {
   "id": "c5",
   "speaker": "narrator",
   "text": "Versus twenty-one thousand, four hundred and seventy-eight invested."
  },
  {
   "id": "c6",
   "speaker": "narrator",
   "text": "Same three hundred a month. Two very different futures."
  }
